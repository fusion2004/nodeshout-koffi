{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "group:allNonMajor"],
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["node"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchDepNames": ["node"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "*"
      ],
      "rangeStrategy": "bump"
    }
  ],
  "rangeStrategy": "bump"
}
